<header id="header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="MOVIFLEX – Accueil">
      <img src="https://moviflex-sketch.github.io/moviflex-assets/images/logo-blanc.png" alt="Logo MOVIFLEX" />
    </a>
    <nav aria-label="Navigation principale">
      <a href="/">Accueil</a>
      <a href="/produits/">Nos produits</a>
      <a href="/faq/">FAQ</a>
      <a href="/blog/">Blog</a>
      <a href="#" onclick="openModal('modal-contact');return false;">Nous contacter</a>
    </nav>
    <div class="header-btns">
      <a href="https://moviflex13.com/app" class="btn-guide-header" aria-label="Accéder au guide vidéo MOVIFLEX">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none"/></svg>
        Mon guide vidéo
      </a>
      {% if secondBtnUrl %}
      <a href="{{ secondBtnUrl }}"{% if secondBtnExternal %} target="_blank" rel="noopener sponsored"{% endif %} class="btn btn-amazon" aria-label="{{ secondBtnLabel }}">
        {% if secondBtnIcon == 'cart' %}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {% endif %}
        {{ secondBtnLabel }}
      </a>
      {% endif %}
    </div>
    <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-logo">
    <img src="https://moviflex-sketch.github.io/moviflex-assets/images/logo-blanc.png" alt="Logo MOVIFLEX" />
  </div>
  <a href="/" onclick="closeMenu()">Accueil</a>
  <a href="/produits/" onclick="closeMenu()">Nos produits</a>
  <a href="/faq/" onclick="closeMenu()">FAQ</a>
  <a href="/blog/" onclick="closeMenu()">Blog</a>
  <a href="#" onclick="closeMenu();openModal('modal-contact');return false;">Nous contacter</a>
  <div class="mobile-menu-actions">
    <a href="https://moviflex13.com/app" class="btn btn-guide-mobile">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none"/></svg>
      Mon guide vidéo
    </a>
    {% if secondBtnUrl %}
    <a href="{{ secondBtnUrl }}"{% if secondBtnExternal %} target="_blank" rel="noopener sponsored"{% endif %} class="btn btn-amazon-mobile">{{ secondBtnLabel }}</a>
    {% endif %}
  </div>
</div>

<!-- MODAL CONTACT -->
<div class="modal-overlay" id="modal-contact" role="dialog" aria-modal="true" aria-labelledby="modal-contact-title" onclick="closeModal('modal-contact')">
  <div class="modal-box" style="max-width:420px;" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="closeModal('modal-contact')" aria-label="Fermer">✕</button>
    <h2 id="modal-contact-title" class="modal-title" style="text-align:center;">Une question ? Contactez-nous</h2>
    <p class="contact-modal-subtitle">L'équipe MOVIFLEX vous répond rapidement, par email ou sur les réseaux.</p>
    <div class="contact-pill-list">
      <a href="mailto:contact@moviflex13.com" class="contact-pill contact-pill--email">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M2 5l8 6 8-6"/></svg>
        contact@moviflex13.com
      </a>
      <a href="https://wa.me/33637184262" target="_blank" rel="noopener" class="contact-pill contact-pill--whatsapp">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.667A8.333 8.333 0 0 0 1.667 10c0 1.467.383 2.842 1.05 4.033L1.667 18.333l4.417-1.025A8.292 8.292 0 0 0 10 18.333 8.333 8.333 0 0 0 18.333 10 8.333 8.333 0 0 0 10 1.667z"/></svg>
        WhatsApp
      </a>
      <a href="https://www.instagram.com/moviflexbykine/" target="_blank" rel="noopener" class="contact-pill contact-pill--instagram">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="16" height="16" rx="4"/><circle cx="10" cy="10" r="3"/><circle cx="14.5" cy="5.5" r="0.5" fill="currentColor"/></svg>
        @moviflexbykine
      </a>
      <a href="https://www.tiktok.com/@moviflexbykine" target="_blank" rel="noopener" class="contact-pill contact-pill--tiktok">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 10a4 4 0 1 0 4 4V3a5 5 0 0 0 5 4"/></svg>
        @moviflexbykine
      </a>
    </div>
    <span class="contact-modal-close-link" onclick="closeModal('modal-contact')">Fermer</span>
  </div>
</div>
