<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/MOVIFLEX-sketch/moviflex-assets/main/images/icone-movi.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  {% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
  <meta name="robots" content="index, follow">
  <meta name="google-site-verification" content="eC5TwffyyPcE8EqByFCkZZC8aB3PzyUl0ToiSq8BXHc" />
  <link rel="canonical" href="https://www.moviflex13.com{{ page.url }}">
  <meta property="og:title" content="{{ ogTitle or title }}" />
  <meta property="og:description" content="{{ ogDescription or description }}" />
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="https://www.moviflex13.com{{ page.url }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css">

  {% if schema %}
  <script type="application/ld+json">{{ schema | safe }}</script>
  {% endif %}
  {% if schema2 %}
  <script type="application/ld+json">{{ schema2 | safe }}</script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body>

{% set secondBtnUrl = secondBtnUrl %}
{% include "header.njk" %}

{{ content | safe }}

{% include "footer.njk" %}

<script src="/common.js"></script>
</body>
</html>
