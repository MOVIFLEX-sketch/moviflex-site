---
layout: base.njk
---
<!-- Widget flottant produit (grand écran uniquement) -->
<a href="/kit-elastiques/" class="sidebar-widget" aria-label="Voir le Kit Élastiques MOVIFLEX">
  <img src="https://moviflex-sketch.github.io/moviflex-assets/images/1.png" alt="Kit Élastiques MOVIFLEX" />
  <span class="sidebar-widget-btn">Voir le Kit</span>
</a>

<!-- Barre collante en bas (mobile/tablette uniquement) -->
<a href="/kit-elastiques/" class="sticky-bottom-bar" aria-label="Voir le Kit Élastiques MOVIFLEX">
  <img src="https://moviflex-sketch.github.io/moviflex-assets/images/1.png" alt="Kit Élastiques MOVIFLEX" />
  <span class="sticky-bottom-bar-text">Kit Élastiques MOVIFLEX</span>
  <span class="sticky-bottom-bar-btn">Voir le Kit</span>
</a>

<!-- ─── HERO ─── -->
<section aria-label="{{ title }}">
  <div class="hero-banner" style="min-height:auto;">
    <img class="hero-banner-img" src="https://moviflex-sketch.github.io/moviflex-assets/images/fond.png" alt="{{ coverAlt }}" loading="eager" fetchpriority="high" />
    <div class="hero-banner-overlay" aria-hidden="true"></div>
    <div class="hero-banner-content">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--c-accent-light);margin-bottom:14px;">{{ category }}</p>
      {% if titleHtml %}<h1 class="hero-title" style="font-size:clamp(28px,4vw,42px);">{{ titleHtml | safe }}</h1>{% else %}<h1 class="hero-title" style="font-size:clamp(28px,4vw,42px);">{{ title }}</h1>{% endif %}
      <div style="display:flex;align-items:center;gap:10px;margin-top:20px;flex-wrap:wrap;">
        <span style="font-size:13px;color:rgba(255,255,255,0.85);">Par <strong style="color:#fff;">Sofiane Mokhtari</strong>, kinésithérapeute D.E.</span>
        <span style="color:rgba(255,255,255,0.4);">·</span>
        <span style="font-size:13px;color:rgba(255,255,255,0.85);">{{ dateDisplay }}</span>
        <span style="color:rgba(255,255,255,0.4);">·</span>
        <span style="font-size:13px;color:rgba(255,255,255,0.85);">{{ readingTime }} de lecture</span>
      </div>
    </div>
  </div>
</section>

<p style="max-width:720px;margin:24px auto 0;padding:0 24px;"><a href="/blog/" style="font-size:13px;font-weight:600;color:var(--c-accent);text-decoration:none;">← Retour au blog</a></p>

<!-- Ce qu'il faut retenir -->
<section style="padding:24px 0 0;">
  <div class="container" style="max-width:720px;">
    <div style="background:var(--c-bg-alt);border-left:3px solid var(--c-accent);border-radius:10px;padding:20px 24px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--c-accent);margin-bottom:8px;">Ce qu'il faut retenir</p>
      <p style="font-size:15px;color:var(--c-dark);line-height:1.65;margin:0;">{{ summary }}</p>
    </div>
  </div>
</section>

<!-- Sommaire -->
<section style="padding:24px 0 0;">
  <div class="container" style="max-width:720px;">
    <div style="background:var(--c-white);border:1px solid rgba(26,26,24,0.08);border-radius:12px;padding:20px 24px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--c-mid);margin-bottom:12px;">Sommaire</p>
      {{ toc | safe }}
    </div>
  </div>
</section>

<!-- Corps de l'article -->
<section style="padding:40px 0;">
  <div class="container" style="max-width:720px;">
    <article class="blog-article">
      {{ content | safe }}
    </article>
  </div>
</section>

<!-- CTA final -->
<section class="cta-section" aria-label="{{ ctaTitle }}">
  <div class="cta-bg" aria-hidden="true"></div>
  <div class="container cta-inner">
    <img src="https://moviflex-sketch.github.io/moviflex-assets/images/1.png" alt="Kit Élastiques MOVIFLEX" style="width:72px;height:72px;border-radius:50%;object-fit:cover;margin:0 auto 20px;display:block;" loading="lazy" />
    <h2 class="cta-title reveal" style="font-size:clamp(24px,3vw,34px);">{{ ctaTitle }}</h2>
    <p class="cta-subtitle reveal reveal-delay-1">{{ ctaText }}</p>
    <div class="cta-btns reveal reveal-delay-2">
      <a href="{{ ctaUrl }}" class="btn btn-amazon">{{ ctaButton }}</a>
    </div>
  </div>
</section>

<!-- Bio auteur -->
<section class="section-alt" style="padding:48px 0;">
  <div class="container" style="max-width:720px;">
    <div style="padding:28px;border-radius:16px;background:var(--c-white);border:1px solid rgba(26,26,24,0.08);display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
      <img src="https://moviflex-sketch.github.io/moviflex-assets/images/photo-kine.png" alt="Sofiane Mokhtari, kinésithérapeute et fondateur de MOVIFLEX" style="width:96px;height:96px;border-radius:50%;object-fit:cover;object-position:center 20%;flex-shrink:0;" loading="lazy" />
      <div>
        <p style="font-family:var(--font-display);font-size:19px;font-weight:600;color:var(--c-dark);margin-bottom:4px;">Sofiane Mokhtari</p>
        <p style="font-size:13px;color:var(--c-accent);font-weight:600;margin-bottom:12px;">Kinésithérapeute D.E.</p>
        <div style="display:flex;gap:10px;">
          <a href="mailto:contact@moviflex13.com" aria-label="Email" style="width:34px;height:34px;border-radius:50%;background:var(--c-accent);display:flex;align-items:center;justify-content:center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="white" stroke-width="1.8"><path d="M3 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M2 5l8 6 8-6"/></svg></a>
